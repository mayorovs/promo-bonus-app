# Host-side settings for docker-compose only. The defaults in
# docker-compose.yml already match these values, so copying this file to .env
# is only necessary to override them, for example when a port is taken.
#
# Application settings for Laravel itself live in backend/.env.

APP_PORT=8000
FRONTEND_PORT=5173
DB_PORT_HOST=55432

DB_DATABASE=promo_bonus
DB_USERNAME=promo
DB_PASSWORD=secret
